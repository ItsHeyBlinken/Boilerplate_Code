{
  "name": "monorepo-turborepo-boilerplate",
  "version": "1.0.0",
  "description": "Turborepo monorepo with a Vite React web app, Express API, and shared package.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^1.11.2",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.0.0",
  "keywords": [
    "monorepo",
    "turborepo",
    "workspaces",
    "boilerplate"
